rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------
    // SUHAR ADVERTISING — FIRESTORE SECURITY RULES
    // -------------------------------------------------------------
    // Architecture:
    // 1. All database mutations (Create/Update/Delete) MUST be mediated
    //    through the authenticated Next.js Admin API layer. Direct client
    //    writes are strictly denied.
    // 2. Public reads are permitted on approved catalog collections.
    // 3. Unrecognized collections are blocked by default.
    // -------------------------------------------------------------

    match /projects/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if false;
    }

    match /clients/{clientId} {
      allow read: if true;
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
